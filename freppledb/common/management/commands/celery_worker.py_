import os
import sys
from django.core.management.base import BaseCommand

class Command(BaseCommand):
    help = 'Запускает Celery worker для frePPLe (исправленная версия)'
    
    def handle(self, *args, **options):
        self.stdout.write(self.style.SUCCESS('Starting frePPLe Celery worker...'))
        
        # Добавляем путь
        project_dir = os.path.dirname(os.path.dirname(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        ))
        sys.path.insert(0, project_dir)
        
        # Настраиваем Django
        os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'freppledb.settings')
        
        import django
        django.setup()
        
        # Получаем Celery app
        from freppledb import celery_app
        
        self.stdout.write(f"App: {celery_app.main}")
        self.stdout.write(f"Broker: {celery_app.conf.broker_url}")
        
        # Запускаем worker
        self.stdout.write("\nStarting worker...")
        
        celery_app.worker_main([
            'worker',
            '--loglevel=info',
            '--pool=solo',
            '--hostname=frepple@%h'
        ])