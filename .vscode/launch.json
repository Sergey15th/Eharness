{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
{
            "name": "FrePPLe ASGI Server (Uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "freppledb.asgi:application",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--log-level",
                "debug"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "freppledb.settings",
                "PYTHONPATH": "${workspaceFolder}",
                "LC_ALL": "en_US.UTF-8",
                "FREPPLE_DATABASE": "default"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "django": true
        },
        {
            "name": "FrePPLe Django RunServer",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/frepplectl.py",
            "args": [
                "runserver",
                "8000",
                "--noreload"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "freppledb.settings",
                "PYTHONPATH": "${workspaceFolder}",
                "LC_ALL": "en_US.UTF-8"
            },
            "console": "integratedTerminal",
            "django": true,
            "justMyCode": false
        },
        {
            "name": "FrePPLe ASGI Debug",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "8000"
            ],
            "env": {
                "DJANGO_SETTINGS_MODULE": "freppledb.settings",
                "PYTHONPATH": "${workspaceFolder}",
                "LC_ALL": "en_US.UTF-8",
                "ASGI_THREADS": "4"
            },
            "console": "integratedTerminal",
            "django": true,
            "justMyCode": false
        },
        {
            "name": "FrePPLe Custom ASGI",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run_asgi.py",
            "env": {
                "DJANGO_SETTINGS_MODULE": "freppledb.settings",
                "PYTHONPATH": "${workspaceFolder}",
                "LC_ALL": "en_US.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Web server Python",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/frepplectl.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "runserver"
            ]
        },
        {
            "name": "Web service Python",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 17999,
            }
        },
        {
            "name": "Planning engine",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/frepple",
            "args": [
                "${workspaceFolder}/freppledb/common/commands.py"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "environment": [
                {
                    "name": "FREPPLE_PLANTYPE",
                    "value": "1"
                },
                {
                    "name": "FREPPLE_CONSTRAINT",
                    "value": "15"
                },
                {
                    "name": "FREPPLE_DATABASE",
                    "value": "default"
                },
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}"
                },
                {
                    "name": "DJANGO_SETTINGS_MODULE",
                    "value": "freppledb.settings"
                },
                {
                    "name": "supply",
                    "value": "1"
                },
                {
                    "name": "fcst",
                    "value": "1"
                },
                {
                    "name": "invplan",
                    "value": "1"
                },
                {
                    "name": "FREPPLE_LOGFILE",
                    "value": "frepple.log"
                },
                {
                    "name": "VIRTUAL_ENV",
                    "value": "${workspaceFolder}/venv"
                },
                {
                    "name": "debugpy",
                    "value": "1"
                }
            ]
        }
    ]
}